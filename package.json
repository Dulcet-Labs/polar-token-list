{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "polar-token-list-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.5.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "build:token-service": "yarn workspace @polar/token-service build",
    "build:admin": "yarn workspace @polar/admin-interface build",
    "dev": "yarn workspace @polar/admin-interface dev",
    "dev:admin": "yarn workspace @polar/admin-interface dev",
    "dev:token-service": "yarn workspace @polar/token-service dev",
    "typecheck": "yarn workspaces run typecheck",
    "typecheck:token-service": "yarn workspace @polar/token-service typecheck",
    "typecheck:admin": "yarn workspace @polar/admin-interface typecheck",
    "clean": "yarn workspaces run clean",
    "clean:token-service": "yarn workspace @polar/token-service clean",
    "clean:admin": "yarn workspace @polar/admin-interface clean",
    "test": "yarn workspaces run test",
    "test:token-service": "yarn workspace @polar/token-service test",
    "test:admin": "yarn workspace @polar/admin-interface test",
    "lint": "yarn workspaces run lint",
    "lint:fix": "yarn workspaces run lint:fix",
    "generate-lists": "yarn workspace @polar/token-service generate",
    "import-candidates": "yarn workspace @polar/token-service import-verified-candidates",
    "import-candidates-dry-run": "yarn workspace @polar/token-service import-candidates-dry-run",
    "import-candidates-verbose": "yarn workspace @polar/token-service import-candidates-verbose",
    "discover": "yarn workspace @polar/token-service discover",
    "bootstrap": "yarn workspace @polar/token-service bootstrap",
    "validate": "yarn workspace @polar/token-service validate",
    "compose": "yarn workspace @polar/token-service compose"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
